# Copie para .env e ajuste. Não versionar .env com segredos.
# Preferência: configure o MySQL em /instalar (grava app/config.php).

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wifidaloja
DB_USERNAME=root
DB_PASSWORD=

# URL pública do painel (HTTPS em produção). Evita Host Header Injection.
APP_URL=https://wifidaloja.com.br

# 1 = mostra erros PHP (só em desenvolvimento)
APP_DEBUG=0

# app/config.php (gerado pelo instalador):
